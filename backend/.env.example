# DocIntel AI Backend Configuration Example

# Optional LLM API Keys (Leave blank to use the high-performance local offline RAG engine)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage directory (defaults to ./storage)
STORAGE_DIR=./storage

# Demo files directory (defaults to ./demo_data)
DEMO_DIR=./demo_data

# RAG & Chunking settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
UNCERTAINTY_THRESHOLD=0.15

# Optional Supabase / Postgres connection
POSTGRES_URL=
